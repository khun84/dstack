{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/status_line.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
